{
  "name": "baseui-solid2-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": "25.8.1",
    "pnpm": "11.8.0"
  },
  "scripts": {
    "typescript": "tsc --noEmit -p tsconfig.json",
    "test:jsdom": "node scripts/test/run.mjs jsdom",
    "test:interactions": "node scripts/test/runtime-interactions.mjs",
    "test:ssr": "node scripts/test/run.mjs ssr",
    "test:types": "node scripts/test/run.mjs types",
    "test:contracts": "node scripts/test/run.mjs contracts",
    "test:coverage-map": "node scripts/tracking/cli.mjs check",
    "inventory:generate": "node scripts/tracking/cli.mjs generate",
    "test:tracking": "node --test test/tracking/*.test.mjs",
    "types:package": "node scripts/distribution/types/build.mjs",
    "test:package-types": "node scripts/distribution/types/test.mjs",
    "test:packed-consumers": "node scripts/distribution/consumers/run.mjs",
    "build:package": "pnpm types:package && node scripts/distribution/build/index.mjs && node scripts/distribution/notices/stage.mjs",
    "test:browsers": "node scripts/test/run.mjs browsers",
    "test:chromium": "node scripts/test/run.mjs chromium",
    "test:chromium:native": "node scripts/test/run.mjs chromium-native",
    "test:browser-batch": "node scripts/test/browser-batch.mjs",
    "test:parity": "node packages/solid/src/internals/contracts/proof/run.mjs parity",
    "upstream:init": "node scripts/upstream/cli.mjs init",
    "upstream:update": "node scripts/upstream/cli.mjs update",
    "upstream:status": "node scripts/upstream/cli.mjs status",
    "upstream:verify": "node scripts/upstream/cli.mjs verify",
    "upstream:abandon": "node scripts/upstream/cli.mjs abandon",
    "test:upstream:git": "node --test test/upstream/git/*.test.mjs",
    "docs:dev": "pnpm docs:generate:demos && vite --config docs/vite.config.ts --host 127.0.0.1 --port 5173",
    "docs:build": "pnpm docs:generate:demos && vite build --config docs/vite.config.ts",
    "docs:preview": "vite preview --config docs/vite.config.ts --host 127.0.0.1 --port 4173",
    "docs:check": "node docs/scripts/demos/generate.mjs --check --complete && tsc --noEmit -p docs/tsconfig.demos.json && node docs/scripts/site/semantic-check.mjs && node docs/scripts/site/check.mjs",
    "docs:test:browser": "node docs/scripts/site/browser-all.mjs && node docs/scripts/site/interactions.mjs",
    "docs:test:interactions": "node docs/scripts/site/click-diagnostics.mjs",
    "docs:generate:demos": "node docs/scripts/demos/generate.mjs",
    "docs:test:demos": "node docs/tests/demos/run.mjs",
    "docs:api": "node docs/scripts/api/index.mjs",
    "docs:api:check": "node docs/scripts/api/index.mjs --check",
    "docs:audit-complete": "node docs/scripts/qualification/audit.mjs",
    "docs:generate-markdown": "node docs/scripts/qualification/stage-markdown.mjs",
    "docs:sync": "node docs/scripts/sync/index.mjs",
    "docs:test:content": "node --test docs/scripts/sync/content.test.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@babel/core": "7.29.7",
    "@microsoft/api-extractor": "7.59.3",
    "@solidjs/babel-plugin": "2.0.0-rc.13",
    "@solidjs/compiler": "2.0.0-rc.13",
    "@solidjs/signals": "2.0.0-rc.13",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@solidjs/web": "2.0.0-rc.13",
    "@tailwindcss/vite": "4.3.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "25.9.9",
    "@vitest/browser-playwright": "4.1.11",
    "baseui-solid2": "workspace:*",
    "clsx": "2.1.1",
    "hast-util-heading-rank": "3.0.0",
    "hast-util-to-string": "3.0.1",
    "jsdom": "27.4.0",
    "playwright": "1.63.0",
    "postcss": "8.5.6",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.6.2",
    "publint": "0.3.25",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "solid-js": "2.0.0-rc.13",
    "tailwindcss": "4.3.1",
    "typescript": "5.9.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "zod": "4.6.5"
  }
}
