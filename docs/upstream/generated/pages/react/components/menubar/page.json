        "meta": "title=\"Anatomy\"",
        "value": "import { Menubar } from 'baseui-solid2/menubar';\nimport { Menu } from 'baseui-solid2/menu';\n\n<Menubar>\n  <Menu.Root>\n    <Menu.Trigger />\n    <Menu.Portal>\n      <Menu.Backdrop />\n      <Menu.Positioner>\n        <Menu.Popup>\n          <Menu.Arrow />\n          <Menu.Item />\n          <Menu.LinkItem />\n          <Menu.Separator />\n\n          <Menu.SubmenuRoot>\n            <Menu.SubmenuTrigger />\n          </Menu.SubmenuRoot>\n\n          <Menu.Group>\n            <Menu.GroupLabel />\n          </Menu.Group>\n\n          <Menu.RadioGroup>\n            <Menu.RadioItem>\n              <Menu.RadioItemIndicator />\n            </Menu.RadioItem>\n          </Menu.RadioGroup>\n\n          <Menu.CheckboxItem>\n            <Menu.CheckboxItemIndicator />\n          </Menu.CheckboxItem>\n\n          <Menu.Viewport />\n        </Menu.Popup>\n      </Menu.Positioner>\n    </Menu.Portal>\n  </Menu.Root>\n</Menubar>;",
